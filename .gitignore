# dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/

# production
build/

# env files (never commit secrets)
.env*

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/

# misc
*.pem
.vercel

# Design files (Pencil sources and HTML exports) are kept locally, not in git.
*.pen
/persoonlijke_website-export.html

# GitHub data fetched at build time (scripts/fetch-github-data.mjs).
/public/data/

# PCB viewer assets pulled from GitHub repos at build time (regenerated by
# scripts/fetch-github-data.mjs); GLBs are derived from STEP at build time
# (scripts/convert-step-models.mjs).
/public/pcb/*

# PDF docs pulled from repo project/ folders at build time (fetch-github-data.mjs).
# Curated PDFs referenced from project .md frontmatter live in the committed curated/ dir.
/public/docs/*
!/public/docs/curated/
# Blog post PDFs, compiled locally from the same .tex (npm run blog:check -- --publish).
!/public/docs/blog/

# Gallery images + demo videos pulled from repo media folders at build time.
# Curated media referenced from project .md frontmatter lives in the committed curated/ dir.
/public/media/*
!/public/media/curated/

# Private, sale-ready digital product masters and delivery archives.
# Public storefront previews live separately under /public/shop/.
/private-products/
